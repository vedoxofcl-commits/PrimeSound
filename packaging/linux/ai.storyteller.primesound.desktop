MimeType=application/x-primesound-session;audio/x-wav;audio/wav;audio/vnd.wave;audio/x-aiff;audio/aiff;audio/flac;audio/x-flac;audio/mpeg;audio/midi;audio/x-midi;
Keywords=daw;audio;mixer;recording;multitrack;midi;editor;music;
